#!/bin/bash
# carry-on CLI: inspect and steer the auto-resume state.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"

die() { echo "carry-on: $*" >&2; exit 1; }

banner() {
  if [ "$(cfg_enabled)" = "true" ]; then
    echo "CARRY-ON ACTIVE — mode: $(cfg_mode)"
  else
    echo "carry-on DISABLED"
  fi
}

cmd_status() {
  ensure_dirs
  banner
  # Status doubles as a recovery point for stranded pendings (post-reboot).
  ensure_sleeper "$ROOT"
  local any=0 f id cwd caught reset chain wake
  for f in "$PENDING_DIR"/*.json; do
    [ -f "$f" ] || continue
    if [ "$any" = 0 ]; then
      echo
      echo "pending wakes:"
      printf '  %-10s %-20s %-8s %-7s %s\n' session project caught wake chain
      any=1
    fi
    id=$(jq -r '.session_id // "?"' "$f")
    cwd=$(jq -r '.cwd // ""' "$f")
    caught=$(jq -r '.caught_at // 0' "$f")
    reset=$(jq -r '.reset_epoch // empty' "$f")
    chain=$(jq -r '.chain // 0' "$f")
    wake=${reset:+$(fmt_time "$reset")}
    printf '  %-10s %-20s %-8s %-7s %s\n' \
      "${id:0:8}" "$(basename "$cwd")" "$(fmt_time "$caught")" "${wake:-retry}" "$chain"
  done
  [ "$any" = 0 ] && echo "no pending wakes"
  if [ -f "$HISTORY_FILE" ]; then
    echo
    echo "recent:"
    jq -cR 'fromjson? // empty' "$HISTORY_FILE" 2>/dev/null | tail -5 \
      | jq -r '"  \(.ts | tostring | .[0:10]) \(.event) \(.session_id[0:8]) \(.cwd | split("/") | last // "")"' 2>/dev/null || true
  fi
}

cmd_cancel() {
  local target="${1:-}"
  [ -n "$target" ] || die "usage: carry-on cancel <session-id-prefix|all>"
  ensure_dirs
  if [ "$target" = "all" ]; then
    rm -f "$PENDING_DIR"/*.json
    echo "cancelled all pending wakes"
  else
    local hit=0 f
    for f in "$PENDING_DIR"/*.json; do
      [ -f "$f" ] || continue
      case "$(basename "$f")" in "$target"*) rm -f "$f"; hit=1 ;; esac
    done
    [ "$hit" = 1 ] || die "no pending wake matches '$target'"
    echo "cancelled $target"
  fi
  # Last pending gone -> the sleeper notices on its next slice and exits;
  # kill it now if we can, so nothing lingers. Children too (an in-flight
  # resume would otherwise survive the cancel).
  if ! pending_exists && [ -f "$LOCK_DIR/pid" ]; then
    local spid
    spid=$(cat "$LOCK_DIR/pid")
    pkill -P "$spid" 2>/dev/null || true
    kill "$spid" 2>/dev/null || true
    rm -rf "$LOCK_DIR"
  fi
}

cmd_log() {
  ensure_dirs
  local prefix="${1:-}" f
  if [ -n "$prefix" ]; then
    f=$(ls -t "$LOGS_DIR/$prefix"*.log 2>/dev/null | head -1)
  else
    f=$(ls -t "$LOGS_DIR"/*.log 2>/dev/null | head -1)
  fi
  [ -n "$f" ] || die "no resume logs${prefix:+ matching '$prefix'}"
  echo "── $f"
  tail -40 "$f"
}

_default_for() { # bash-3.2-safe defaults lookup (no case inside $())
  case "$1" in
    mode) echo resume ;;
    max_chain) echo 3 ;;
    max_wait) echo 604800 ;;
    probe_model) echo haiku ;;
    daily_cap) echo 12 ;;
    chain_decay) echo 3600 ;;
    resume_default_mode) echo acceptEdits ;;
    resume_bypass_mode) echo bypass ;;
    *) echo "" ;;
  esac
}

cmd_config() {
  local key="${1:-}" value="${2:-}"
  if [ -z "$key" ]; then
    banner
    local k
    for k in mode max_chain chain_decay max_wait probe_model daily_cap resume_default_mode resume_bypass_mode deny; do
      echo "$k=$(config_get "$k" "$(_default_for "$k")")"
    done
    return
  fi
  [ -n "$value" ] || die "usage: carry-on config <key> <value>"
  case "$key" in
    mode) case "$value" in resume|notify) ;; *) die "mode is resume|notify" ;; esac ;;
    resume_default_mode) case "$value" in acceptEdits|skip) ;; *) die "resume_default_mode is acceptEdits|skip" ;; esac ;;
    resume_bypass_mode) case "$value" in acceptEdits|bypass) ;; *) die "resume_bypass_mode is acceptEdits|bypass" ;; esac ;;
    max_chain|chain_decay|max_wait|daily_cap)
      case "$value" in "" | *[!0-9]*) die "$key must be a whole number, got '$value'" ;; esac ;;
    enabled|probe_model|deny|resume_prompt) ;;
    *) die "unknown key '$key' (enabled mode resume_prompt max_chain chain_decay max_wait probe_model daily_cap resume_default_mode resume_bypass_mode deny)" ;;
  esac
  config_set "$key" "$value"
  echo "$key=$value"
}

# Set settings.json .statusLine to a command, preserving other keys. Backs up
# first and validates the result before replacing — a broken edit never lands.
_set_statusline_command() { # _set_statusline_command COMMAND
  local cmd="$1" tmp="$SETTINGS_FILE.tmp.$$"
  mkdir -p "$(dirname "$SETTINGS_FILE")"
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.carry-on.bak"
    jq --arg c "$cmd" '.statusLine = {type:"command", command:$c}' "$SETTINGS_FILE" > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; return 1; }
  else
    jq -n --arg c "$cmd" '{statusLine:{type:"command", command:$c}}' > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; return 1; }
  fi
  jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$SETTINGS_FILE"
}

# Wire the statusline badge as a drop-in fragment — never overwriting another
# tool's statusline. The badge is a stable copy (survives plugin updates) run by
# a fragment in statusline.d/. Exit 3 + a NEEDS-CHOICE line means the user
# already runs their own statusline and the caller must decide how to join it.
cmd_statusline() {
  ensure_dirs
  mkdir -p "$STATUSLINE_D" "$(dirname "$STATUSLINE_BADGE")"
  if ! cp "$ROOT/hooks/statusline.sh" "$STATUSLINE_BADGE" || ! chmod +x "$STATUSLINE_BADGE"; then
    die "could not install the badge script to $STATUSLINE_BADGE"
  fi
  cat > "$STATUSLINE_FRAGMENT" <<EOF
#!/bin/bash
# statusline.d fragment — carry-on auto-resume badge. Needs the Claude Code
# statusline JSON on stdin. Drop-in: delete this file to remove the badge.
exec bash "$STATUSLINE_BADGE"
EOF

  # Already reachable (an existing dispatcher picks up the fragment, or a prior
  # chain names the badge) → nothing to wire.
  if statusline_wired; then
    : > "$CARRY_ON_HOME/statusline_wired"
    echo "carry-on: badge wired — your statusline runs the drop-in fragment."
    return 0
  fi

  local cmd
  cmd=$(jq -r '.statusLine.command // empty' "$SETTINGS_FILE" 2>/dev/null || true)
  if [ -z "$cmd" ]; then
    # No statusline yet: install the generic dispatcher and point at it. Nothing
    # to clobber, and a dispatcher lets the next tool drop a fragment too.
    if ! cp "$ROOT/hooks/statusline-dispatch.sh" "$STATUSLINE_DISPATCH" || ! chmod +x "$STATUSLINE_DISPATCH"; then
      die "could not install the dispatcher to $STATUSLINE_DISPATCH"
    fi
    _set_statusline_command "bash \"$STATUSLINE_DISPATCH\"" || die "could not update $SETTINGS_FILE"
    : > "$CARRY_ON_HOME/statusline_wired"
    echo "carry-on: installed a drop-in statusline showing the badge. Other tools can add badges by dropping a file in $STATUSLINE_D."
    return 0
  fi

  # A statusline exists and does not reach us — never overwrite it. Hand the
  # decision (join it vs. convert to the drop-in dispatcher) back to the caller.
  printf 'NEEDS-CHOICE\t%s\n' "$cmd"
  return 3
}

case "${1:-help}" in
  status)  cmd_status ;;
  cancel)  shift; cmd_cancel "$@" ;;
  on)      config_set enabled true;  echo "carry-on enabled" ;;
  off)     config_set enabled false; echo "carry-on disabled (pending wakes kept; carry-on cancel all to drop them)" ;;
  log)     shift; cmd_log "$@" ;;
  config)  shift; cmd_config "$@" ;;
  statusline) cmd_statusline ;;
  help|--help|-h)
    cat <<'EOF'
carry-on — auto-resume Claude Code sessions after usage-limit resets
  carry-on status              pending wakes + recent history
  carry-on cancel <id|all>     drop pending wake(s)
  carry-on on|off              enable / disable catching
  carry-on config [key value]  show or set config (mode=resume|notify, ...)
  carry-on log [id-prefix]     tail a resume log
  carry-on statusline          wire the always-visible badge (drop-in, safe)
EOF
    ;;
  *) die "unknown command '$1' (try: carry-on help)" ;;
esac
